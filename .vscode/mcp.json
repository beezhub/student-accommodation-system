{
	"inputs": [],
	"servers": {
		"sequentialthinking": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"mcp/sequentialthinking"
			],
			"type": "stdio"
		},
		"memory": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"-v",
				"/local-directory:/local-directory",
				"mcp/memory"
			],
			"type": "stdio"
		},
		"atlassian": {
			"command": "npx",
			"args": [
				"-y",
				"mcp-remote",
				"https://mcp.atlassian.com/v1/sse"
			]
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			]
		},
		"oraios/serena": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"serena==latest",
				"--context",
				"ide-assistant"
			]
		},
		"angular-cli": {
			"command": "npx",
			"args": [
				"-y",
				"@angular/cli",
				"mcp"
			]
		}
	}
	
}