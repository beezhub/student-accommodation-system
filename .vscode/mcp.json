{
	"inputs": [],
	"servers": {
		"sequentialthinking": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"mcp/sequentialthinking"
			],
			"type": "stdio"
		},
		"memory": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"-v",
				"/local-directory:/local-directory",
				"mcp/memory"
			],
			"type": "stdio"
		},
		"atlassian": {
			"command": "npx",
			"args": [
				"-y",
				"mcp-remote",
				"https://mcp.atlassian.com/v1/sse"
			]
		}
	}
	
}