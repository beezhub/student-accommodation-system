# ====================================
# Deployment overlay variables — GH-246
# ====================================
#
# The second --env-file, layered over .env:
#
#   docker compose --env-file .env --env-file .env.deploy \
#     -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.deploy.yml \
#     up -d --no-build --remove-orphans
#
# .env holds the values that are the same wherever the stack runs (secrets, mail, feature
# settings). This file holds the ones that only exist once there is a server: which images to pull,
# where the managed database is, and what hostname the environment answers on.
#
# One per environment. NONPROD and PROD share none of these values.
# Copy to .env.deploy on the host. Never commit the copy; it is gitignored.

# ====================================
# Images — REQUIRED, and digests not tags
# ====================================
# docker-build.yml pushes no :latest, and :main is mutable — the same tag means different bytes
# next week, so a redeploy would not be reproducible and PROD could not promote what NONPROD ran.
# Take the digest from the Docker Build & Push run, or:
#   docker buildx imagetools inspect ghcr.io/beezhub/student-accommodation-backend:sha-<sha>
BACKEND_IMAGE=ghcr.io/beezhub/student-accommodation-backend@sha256:...
FRONTEND_IMAGE=ghcr.io/beezhub/student-accommodation-frontend@sha256:...

# ====================================
# DO Managed PostgreSQL — REQUIRED
# ====================================
# From the DigitalOcean console, Databases -> your cluster -> Connection details, private network.
# Use the VPC (private) host: it keeps database traffic off the public internet and off the
# bandwidth bill.
#
# sslmode=require is not optional — DigitalOcean enforces TLS, and without it the server closes the
# connection and the backend fails at startup with a bare EOF that looks like a network fault.
DB_URL=jdbc:postgresql://private-db-postgresql-fra1-00000-do-user-000000-0.m.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DB_HOST=private-db-postgresql-fra1-00000-do-user-000000-0.m.db.ondigitalocean.com
DB_PORT=25060
DB_SSLMODE=require
POSTGRES_DB=defaultdb
# USER_DB and PASSWORD_DB come from the same panel and belong in .env, not here.

# ====================================
# Hostname-derived — REQUIRED
# ====================================
# All four follow from the environment's hostname (operator runbook section 0.1). ALLOWED_ORIGINS
# and APP_BASE_URL have no defaults in application.yml; the backend will not start without them.
APP_BASE_URL=https://nonprod.example.co.za
ALLOWED_ORIGINS=https://nonprod.example.co.za
STORAGE_PUBLIC_ORIGIN=https://nonprod.example.co.za
GRAFANA_ROOT_URL=https://nonprod.example.co.za/grafana

# ====================================
# Reverse proxy
# ====================================
# The peer address the backend sees for proxied requests: the frontend container's static address
# from docker-compose.deploy.yml. It is matched as an exact string, not a CIDR range (GH-252), so
# a subnet here silently disables X-Forwarded-For handling and puts every client in one rate-limit
# bucket. Leave it unless the subnet in the overlay changes.
APP_SECURITY_TRUSTED_PROXIES=172.28.0.10

# ====================================
# First administrator — first deploy only
# ====================================
# The seeded demo admin is disabled outside demo, so on an empty database this pair is the only way
# to create a PLATFORM_ADMIN. Set both, deploy, log in, change the password — then CLEAR BOTH and
# redeploy, so a long-lived password is not sitting in a file on the host.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ====================================
# Optional
# ====================================
# Server-side geocoding of building addresses. Buildings can be created without it; their
# coordinates are simply not resolved.
GOOGLE_MAPS_API_KEY=

# Document retention deletes files irreversibly when false. Leave it true until the retention
# section of docs/BACKUP_AND_RESTORE.md has been read and a decision made.
DOCUMENT_RETENTION_DRY_RUN=true

# The 1 GiB managed plan permits far fewer connections than a local container. Raising the pool
# means checking the plan's connection limit first — exhausting it takes the database down for
# every client, not only this one.
HIKARI_MAX_POOL_SIZE=25
HIKARI_MIN_IDLE=10
