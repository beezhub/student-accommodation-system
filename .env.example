# ====================================
# Student Accommodation System
# Environment Variables Template
# ====================================
#
# IMPORTANT SECURITY NOTICE:
# This file contains PLACEHOLDER values only.
# Copy this file to .env and replace all values with actual credentials.
# NEVER commit .env files to version control.
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Ensure .env is in .gitignore (already configured)
#
# ====================================

# ====================================
# Database Configuration
# ====================================
DB_URL=jdbc:postgresql://localhost:5432/studentaccommodationlocaldb
USER_DB=your-database-username-here
PASSWORD_DB=your-database-password-here  # REQUIRED in all environments

# ====================================
# Redis Configuration (Cache & Token Blacklist)
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ====================================
# JWT Configuration
# REQUIRED — no default; app will refuse to start without it
# Generate with: openssl rand -base64 64  (must be >= 64 chars)
# ====================================
# REQUIRED: must be at least 64 characters, base64-encoded
JWT_SECRET=your-jwt-secret-key-here-minimum-64-chars-base64-encoded
JWT_EXPIRATION=36000000
JWT_ADMIN_EXPIRATION=14400000

# ====================================
# S3 Object Storage
# REQUIRED — no defaults in docker-compose
# ====================================
# REQUIRED
S3_ACCESS_KEY=your-s3-access-key-here
# REQUIRED
S3_SECRET_KEY=your-s3-secret-key-here
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=student-accommodation-bucket
# Locally these point at the minio compose service, an S3-compatible container whose root user is
# the key pair above. On NONPROD and PROD (Amazon S3) docker-compose.aws.yml sets:
#   S3_ENDPOINT=https://s3.af-south-1.amazonaws.com
#   S3_REGION=af-south-1         the bucket's region; blank for the local container
#   S3_CREDENTIALS=aws-instance-role
#                                or static (the default) to use the access key pair above,
#                                for example an IAM user on a host outside AWS
#   S3_CREATE_BUCKET=false       Terraform owns the bucket on S3
# With aws-instance-role the access key pair is ignored, but compose still requires it to be set.
S3_REGION=
S3_CREDENTIALS=static
S3_CREATE_BUCKET=true

# ====================================
# Google Maps Geocoding (optional)
# ====================================
# Address lookup on the building form. Leave blank and the feature is off: the backend reports
# geocoding as unconfigured, the form's autocomplete is disabled, and no requests are made — this
# is a paid API, and a deployment that has not chosen to pay for it should not be calling it.
#
# One key, used only by the backend. Restrict it by server IP in the Google Cloud Console.
# There is deliberately no frontend key: the browser never talks to Google, it calls
# /api/geocoding/search, so a key is never exposed to anyone who loads the page.
# Get one from: https://console.cloud.google.com/apis/credentials
# Enable "Places API (New)" for the key's project. The Geocoding API is no longer used.
GOOGLE_MAPS_API_KEY=
# Optional two-letter country code that limits suggestions to one country, for example za.
GOOGLE_PLACES_REGION_CODE=

# ====================================
# Mail Configuration (SMTP)
# ====================================
# For development: Use MailHog (localhost:1025)
# For production: Use your SMTP provider credentials
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=your-smtp-username-here
MAIL_PASSWORD=your-smtp-password-here
# From address. Blank sends from MAIL_USERNAME, which suits providers whose login is an email
# address. SES SMTP logs in with an IAM key ID, so PROD sets no-reply@beezhub.co.za (GH-356).
MAIL_FROM=
# smtp (the default) or ses-api, which sends through the SES v2 API with the AWS default credentials
# instead of an SMTP server. PROD uses ses-api: SES has no SMTP endpoint in af-south-1 (GH-360).
MAIL_TRANSPORT=smtp
# Set to true when using an authenticated SMTP provider (e.g. Gmail, SendGrid)
# For development with MailHog, use false
MAIL_SMTP_AUTH=false
# Set to true to enable STARTTLS encryption (required by most production SMTP providers)
# For development with MailHog, use false
MAIL_STARTTLS_ENABLE=false

# ====================================
# Grafana Configuration
# REQUIRED — no defaults in docker-compose
# ====================================
# REQUIRED: Grafana admin password (do not leave as default)
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password-here

# Grafana connects to the application database with these. They must match USER_DB and PASSWORD_DB
# above; the provisioned datasource previously named a database that did not exist (GH-162).
GRAFANA_ADMIN_USER=admin
# If Grafana is configured with a database backend
GRAFANA_DB_PASSWORD=your-grafana-db-password-here
# Where provisioned alerts are emailed. Defaults to APP_SUPPORT_EMAIL. Delivery uses the MAIL_*
# account above when the production overlay is in use; GRAFANA_SMTP_FROM defaults to MAIL_USERNAME.
GRAFANA_ALERT_EMAIL=
GRAFANA_SMTP_FROM=
# Public address of Grafana if a server runs its own behind Caddy. Must include the /grafana path.
# Unused locally, and on NONPROD and PROD, which use Grafana Cloud (#381).
GRAFANA_ROOT_URL=https://nonprod.example.co.za/grafana

# ====================================
# PROD on AWS (docker-compose.aws.yml only)
# ====================================
# Unused locally. On PROD and NONPROD every key below is required, and the overlay stops the deploy
# if one is missing. See docs/PROD_ENVIRONMENT_PLAN.md.
#
# PROD also changes values set elsewhere in this file:
#   DB_URL                 jdbc:postgresql://<rds-endpoint>:5432/<database>?sslmode=require
#   S3_ENDPOINT            https://s3.af-south-1.amazonaws.com
#   S3_BUCKET              the documents bucket
#   STORAGE_PUBLIC_ORIGIN  https://<bucket>.s3.af-south-1.amazonaws.com
#   GRAFANA_ADMIN_PASSWORD, S3_ACCESS_KEY, S3_SECRET_KEY must still be set: compose checks
#   them before it knows Grafana and the storage container are switched off.
#
# Images by digest, as pushed to ECR by the build (#337): <registry>/<repository>@sha256:<digest>
BACKEND_IMAGE=
FRONTEND_IMAGE=
# Grafana Cloud stack details, from the Grafana Cloud portal (Loki and Prometheus "Details" pages).
# The API key needs logs:write and metrics:write. NONPROD uses the same stack, ideally with its own
# API key.
GRAFANA_CLOUD_LOGS_URL=
GRAFANA_CLOUD_LOGS_USER=
GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_METRICS_USER=
GRAFANA_CLOUD_API_KEY=

# ====================================
# NONPROD (docker-compose.nonprod.yml)
# ====================================
# NONPROD runs the AWS overlay too, on top of which its own overlay lists the differences. It needs
# the keys in the section above, and these values elsewhere in this file:
#   DB_URL                 jdbc:postgresql://db:5432/studentaccommodationlocaldb?sslmode=require
#                          compose checks it is set, then docker-compose.nonprod.yml replaces it
#   S3_ENDPOINT            https://s3.af-south-1.amazonaws.com
#   S3_BUCKET              beezhub-sas-nonprod-documents
#   STORAGE_PUBLIC_ORIGIN  https://beezhub-sas-nonprod-documents.s3.af-south-1.amazonaws.com
#   S3_ACCESS_KEY          the IAM user's key, from SSM /sas-nonprod/AWS_ACCESS_KEY_ID
#   S3_SECRET_KEY          its secret, from SSM /sas-nonprod/AWS_SECRET_ACCESS_KEY (infra/terraform/nonprod)
#   EXAMPLE_DATA           true, because NONPROD keeps the seed's example data (#365)
#   MAIL_HOST              any value: docker-compose.prod.yml requires it, and mail goes through SES

# ====================================
# Application Configuration
# ====================================
APP_BASE_URL=http://localhost:4200
APP_SUPPORT_EMAIL=accommodation@university.edu
APP_UNIVERSITY_NAME=University

# ====================================
# File Upload Configuration
# ====================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=20MB

# ====================================
# Runtime
# ====================================
# Timestamp columns have no time zone and the application writes them from the JVM default, so
# this pins both. Changing it reinterprets every value already stored, so it is a one-time
# decision rather than a per-environment preference.
APP_TIMEZONE=UTC

# Shown in email footers alongside APP_SUPPORT_EMAIL.
APP_CONTACT_PHONE=+27 (0) 11 000 0000

# Redis sits on the request path for token-blacklist checks and auth rate limiting, and both fail
# open, so these are deliberately short: a stalled server should be given up on rather than holding
# a request thread. The pool wait is bounded for the same reason (GH-162).
REDIS_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_POOL_MAX_WAIT_MS=1000

# Largest single document a student may upload, in bytes. Enforced server-side with a 422; the
# servlet multipart limit above is the outer bound. Only PDF, JPG and PNG are accepted, and the
# type is decided from the file contents rather than the declared header (GH-144).
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760

# ====================================
# Feature Flags
# ====================================
# AUTO_ALLOCATION_ENABLED was removed in GH-142. The auto-allocation flag is stored in
# ff4j_features and toggled by a platform admin through /api/admin/features. It ships disabled.
BATCH_ENABLED=true
BATCH_INTERVAL_MS=21600000
BATCH_SIZE=50
BATCH_ON_EXPIRY=true

# ====================================
# Notification Configuration
# ====================================
NOTIFICATION_RETRY_DELAY_MINUTES=5
NOTIFICATION_RETRY_CHECK_INTERVAL_MS=300000

# ====================================
# Async Executor Configuration
# ====================================
# Thread pool settings for async notifications
# Increase these for high-volume batch allocations (100+ notifications)
ASYNC_CORE_POOL_SIZE=10
ASYNC_MAX_POOL_SIZE=20
ASYNC_QUEUE_CAPACITY=500

# ====================================
# Allocation Configuration
# ====================================
OFFER_EXPIRY_DAYS=7
CHECK_IN_EXPIRY_DAYS=7
EXPIRY_CHECK_INTERVAL_MS=3600000

# ====================================
# HikariCP Configuration
# ====================================
# Production: MAX_POOL_SIZE=30, MIN_IDLE=10
# Dev: MAX_POOL_SIZE=10, MIN_IDLE=5
HIKARI_MAX_POOL_SIZE=30
HIKARI_MIN_IDLE=10

# ====================================
# Storage Cleanup Job
# ====================================
# Cron for the nightly orphan-file cleanup (Spring cron, 6 fields)
STORAGE_CLEANUP_CRON=0 0 3 * * *
# Objects younger than this many minutes are never deleted, so in-flight uploads are safe
STORAGE_CLEANUP_GRACE_MINUTES=60

# ====================================
# Document Retention
# ====================================
# Deletes a student's document pack this many months after their last application closes and their
# last tenancy ends. The clock is the student's history, not the upload date — a pack is reused
# across applications to different companies, so anything still running anywhere keeps everything.
DOCUMENT_RETENTION_MONTHS=12
# Cron for the nightly retention sweep (Spring cron, 6 fields)
DOCUMENT_RETENTION_CRON=0 30 3 * * *
# Reporting only while true: the job logs what it would delete and deletes nothing. Deletion is
# irreversible and the first real run acts on the whole backlog, so read the dry-run count and
# docs/BACKUP_AND_RESTORE.md before setting this to false.
DOCUMENT_RETENTION_DRY_RUN=true

# ====================================
# First Platform Administrator
# ====================================
# The seeded demo admin is disabled outside demo environments. Set these on a fresh NONPROD/PROD
# database to create the first PLATFORM_ADMIN; it is forced to change its password on first login.
# Safe to leave set afterwards: once that account has changed its password, further startups leave
# it alone rather than resetting it.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Only set to true to deliberately reset a lost platform admin password on the next startup. Clear
# it again immediately afterwards, or every future deploy will keep resetting the password.
ADMIN_BOOTSTRAP_FORCE=false
# Set to true ONLY for local demos to keep the seeded admin@studentaccommodation.com login working.
DEMO_SEED=false
# true (the default) keeps the seed's example institutions, "2026" academic year and demo admin.
# PROD sets false, once, before the first deploy that carries V2026_11_04_1000 (#365): the
# migration runs one time, and docker-compose.aws.yml refuses to start PROD without the value.
EXAMPLE_DATA=true

# ====================================
# Spring Profile
# ====================================
# Leave empty for local development (readable console logs, Swagger UI available).
# Set to "prod" in NONPROD and PROD: disables Swagger, makes /v3/api-docs PLATFORM_ADMIN-only,
# and switches logging to JSON. The profile name must be exactly "prod" — application-prod.yml
# and logback-spring.xml both key off it.
SPRING_PROFILES_ACTIVE=

# ====================================
# Auth Rate Limiting
# ====================================
# Comma-separated addresses of reverse proxies whose X-Forwarded-For header may be trusted.
# REQUIRED behind nginx or a load balancer: without it every client shares the proxy's address,
# so one bucket throttles the whole deployment. Each entry may be a single address or a CIDR
# range, for example 172.18.0.0/16 or the proxy container IP. An entry that is neither is logged
# and ignored rather than failing startup.
APP_SECURITY_TRUSTED_PROXIES=
# Unauthenticated auth requests allowed per client per minute.
AUTH_RATE_LIMIT_PER_MINUTE=30

# ====================================
# Prometheus Metrics Scrape
# ====================================
# /actuator/prometheus is PLATFORM_ADMIN-only while this is empty, so Prometheus cannot scrape and
# the Grafana dashboards stay empty. One value serves both sides: the backend reads it directly
# and compose hands the same value to Prometheus as a secret. The key must be present even when
# empty. Never publish the actuator port.
PROMETHEUS_SCRAPE_USER=prometheus
PROMETHEUS_SCRAPE_PASSWORD=

# ====================================
# SMTP Transport
# ====================================
# Real providers require both of these; MailHog locally does not.
# MAIL_SMTP_AUTH and MAIL_STARTTLS_ENABLE are listed above with the mail settings.
# Timeouts in milliseconds. Without them a hung SMTP host blocks a notification thread forever.
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# ====================================
# CORS, CSP and Redis Auth
# ====================================
# REQUIRED. Comma-separated browser origins allowed to call the API. There is no default: the app
# refuses to start without it, rather than falling back to localhost and blocking the real front end.
ALLOWED_ORIGINS=http://localhost:4200
# Origin the browser loads presigned document and building-image URLs from. Must match the storage
# endpoint the browser can reach, or the Content-Security-Policy blocks every image.
STORAGE_PUBLIC_ORIGIN=http://localhost:9000
# Set wherever Redis requires authentication; empty locally.
REDIS_PASSWORD=
