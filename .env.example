# ====================================
# Student Accommodation System
# Environment Variables Template
# ====================================
#
# IMPORTANT SECURITY NOTICE:
# This file contains PLACEHOLDER values only.
# Copy this file to .env and replace all values with actual credentials.
# NEVER commit .env files to version control.
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Ensure .env is in .gitignore (already configured)
#
# ====================================

# ====================================
# Database Configuration
# ====================================
DB_URL=jdbc:postgresql://localhost:5432/studentaccommodationlocaldb
USER_DB=your-database-username-here
PASSWORD_DB=your-database-password-here  # REQUIRED in all environments

# ====================================
# Redis Configuration (Cache & Token Blacklist)
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ====================================
# JWT Configuration
# REQUIRED — no default; app will refuse to start without it
# Generate with: openssl rand -base64 64  (must be >= 64 chars)
# ====================================
# REQUIRED: must be at least 64 characters, base64-encoded
JWT_SECRET=your-jwt-secret-key-here-minimum-64-chars-base64-encoded
JWT_EXPIRATION=36000000
JWT_ADMIN_EXPIRATION=14400000

# ====================================
# MinIO Configuration (Object Storage)
# REQUIRED — no defaults in docker-compose
# ====================================
# REQUIRED
MINIO_ACCESS_KEY=your-minio-access-key-here
# REQUIRED
MINIO_SECRET_KEY=your-minio-secret-key-here
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=student-accommodation-bucket

# ====================================
# Google Maps API Configuration
# REQUIRED if GEOCODING_ENABLED=true
# Get your API keys from: https://console.cloud.google.com/apis/credentials
# ====================================
# REQUIRED: Backend geocoding key — restrict by server IP in Google Cloud Console
GOOGLE_MAPS_API_KEY=your-backend-api-key-here
# REQUIRED: Frontend Maps key — restrict by HTTP referrer in Google Cloud Console
GOOGLE_MAPS_FRONTEND_API_KEY=your-frontend-api-key-here
# Set to false to disable geocoding feature
GEOCODING_ENABLED=true

# ====================================
# Mail Configuration (SMTP)
# ====================================
# For development: Use MailHog (localhost:1025)
# For production: Use your SMTP provider credentials
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=your-smtp-username-here
MAIL_PASSWORD=your-smtp-password-here
# Set to true when using an authenticated SMTP provider (e.g. Gmail, SendGrid)
# For development with MailHog, use false
MAIL_SMTP_AUTH=false
# Set to true to enable STARTTLS encryption (required by most production SMTP providers)
# For development with MailHog, use false
MAIL_STARTTLS_ENABLE=false

# ====================================
# Grafana Configuration
# REQUIRED — no defaults in docker-compose
# ====================================
# REQUIRED: Grafana admin password (do not leave as default)
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password-here

# Grafana connects to the application database with these. They must match USER_DB and PASSWORD_DB
# above; the provisioned datasource previously named a database that did not exist (GH-162).
GRAFANA_ADMIN_USER=admin
# If Grafana is configured with a database backend
GRAFANA_DB_PASSWORD=your-grafana-db-password-here

# ====================================
# Application Configuration
# ====================================
APP_BASE_URL=http://localhost:4200
APP_SUPPORT_EMAIL=accommodation@university.edu
APP_UNIVERSITY_NAME=University

# ====================================
# File Upload Configuration
# ====================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=20MB

# ====================================
# Runtime
# ====================================
# Timestamp columns have no time zone and the application writes them from the JVM default, so
# this pins both. Changing it reinterprets every value already stored, so it is a one-time
# decision rather than a per-environment preference.
APP_TIMEZONE=UTC

# Shown in email footers alongside APP_SUPPORT_EMAIL.
APP_CONTACT_PHONE=+27 (0) 11 000 0000

# Redis sits on the request path for token-blacklist checks and auth rate limiting, and both fail
# open, so these are deliberately short: a stalled server should be given up on rather than holding
# a request thread. The pool wait is bounded for the same reason (GH-162).
REDIS_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_POOL_MAX_WAIT_MS=1000

# Largest single document a student may upload, in bytes. Enforced server-side with a 422; the
# servlet multipart limit above is the outer bound. Only PDF, JPG and PNG are accepted, and the
# type is decided from the file contents rather than the declared header (GH-144).
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760

# ====================================
# Feature Flags
# ====================================
# AUTO_ALLOCATION_ENABLED was removed in GH-142. The auto-allocation flag is stored in
# ff4j_features and toggled by a platform admin through /api/admin/features. It ships disabled.
BATCH_ENABLED=true
BATCH_INTERVAL_MS=21600000
BATCH_SIZE=50
BATCH_ON_EXPIRY=true

# ====================================
# Notification Configuration
# ====================================
NOTIFICATION_RETRY_DELAY_MINUTES=5
NOTIFICATION_RETRY_CHECK_INTERVAL_MS=300000

# ====================================
# Async Executor Configuration
# ====================================
# Thread pool settings for async notifications
# Increase these for high-volume batch allocations (100+ notifications)
ASYNC_CORE_POOL_SIZE=10
ASYNC_MAX_POOL_SIZE=20
ASYNC_QUEUE_CAPACITY=500

# ====================================
# Allocation Configuration
# ====================================
OFFER_EXPIRY_DAYS=7
CHECK_IN_EXPIRY_DAYS=7
EXPIRY_CHECK_INTERVAL_MS=3600000

# ====================================
# HikariCP Configuration
# ====================================
# Production: MAX_POOL_SIZE=30, MIN_IDLE=10
# Dev: MAX_POOL_SIZE=10, MIN_IDLE=5
HIKARI_MAX_POOL_SIZE=30
HIKARI_MIN_IDLE=10

# ====================================
# Storage Cleanup Job
# ====================================
# Cron for the nightly orphan-file cleanup (Spring cron, 6 fields)
STORAGE_CLEANUP_CRON=0 0 3 * * *
# Objects younger than this many minutes are never deleted, so in-flight uploads are safe
STORAGE_CLEANUP_GRACE_MINUTES=60

# ====================================
# First Platform Administrator
# ====================================
# The seeded demo admin is disabled outside demo environments. Set these on a fresh NONPROD/PROD
# database to create the first PLATFORM_ADMIN; it is forced to change its password on first login.
# Clear both variables once that is done.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Set to true ONLY for local demos to keep the seeded admin@studentaccommodation.com login working.
DEMO_SEED=false

# ====================================
# Spring Profile
# ====================================
# Leave empty for local development (readable console logs, Swagger UI available).
# Set to "prod" in NONPROD and PROD: disables Swagger, makes /v3/api-docs PLATFORM_ADMIN-only,
# and switches logging to JSON. The profile name must be exactly "prod" — application-prod.yml
# and logback-spring.xml both key off it.
SPRING_PROFILES_ACTIVE=

# ====================================
# Auth Rate Limiting
# ====================================
# Comma-separated addresses of reverse proxies whose X-Forwarded-For header may be trusted.
# REQUIRED behind nginx or a load balancer: without it every client shares the proxy's address,
# so one bucket throttles the whole deployment. Example: 172.18.0.0/16 or the proxy container IP.
APP_SECURITY_TRUSTED_PROXIES=
# Unauthenticated auth requests allowed per client per minute.
AUTH_RATE_LIMIT_PER_MINUTE=30

# ====================================
# Prometheus Metrics Scrape
# ====================================
# /actuator/prometheus is PLATFORM_ADMIN-only while this is empty, so Prometheus cannot scrape and
# the Grafana dashboards stay empty. Set a password here AND write the same value into
# tools/prometheus/scrape-password, which Prometheus reads. Never publish the actuator port.
PROMETHEUS_SCRAPE_USER=prometheus
PROMETHEUS_SCRAPE_PASSWORD=

# ====================================
# SMTP Transport
# ====================================
# Real providers require both of these; MailHog locally does not.
# MAIL_SMTP_AUTH and MAIL_STARTTLS_ENABLE are listed above with the mail settings.
# Timeouts in milliseconds. Without them a hung SMTP host blocks a notification thread forever.
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# ====================================
# CORS, CSP and Redis Auth
# ====================================
# REQUIRED. Comma-separated browser origins allowed to call the API. There is no default: the app
# refuses to start without it, rather than falling back to localhost and blocking the real front end.
ALLOWED_ORIGINS=http://localhost:4200
# Origin the browser loads presigned document and building-image URLs from. Must match the storage
# endpoint the browser can reach, or the Content-Security-Policy blocks every image.
STORAGE_PUBLIC_ORIGIN=http://localhost:9000
# Set wherever Redis requires authentication; empty locally.
REDIS_PASSWORD=
